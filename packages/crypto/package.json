  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/packages.git",
    "directory": "packages/crypto"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
