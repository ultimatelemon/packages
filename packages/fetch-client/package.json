{
  "name": "@ultimatelemon-eu/fetch-client",
  "version": "1.0.0",
  "description": "fetch for rate-limited APIs: a token bucket that stays under the limit, Retry-After on 429, timeouts, one retry on 5xx, typed errors and logs without credentials.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/packages.git",
    "directory": "packages/fetch-client"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
