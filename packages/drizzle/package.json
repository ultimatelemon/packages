{
  "name": "@ultimatelemon-eu/drizzle",
  "version": "1.0.0",
  "description": "Drizzle on node-postgres for UltimateLemon apps: a lazy client, Postgres error helpers, and migrations at container start behind an advisory lock.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/packages.git",
    "directory": "packages/drizzle"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.44",
    "pg": ">=8"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
