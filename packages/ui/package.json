{
  "name": "@ultimatelemon-eu/ui",
  "version": "0.1.0",
  "description": "The UltimateLemon theme and shadcn-style React components on semantic CSS variables, for Tailwind 4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/packages.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./BRAND.md": "./BRAND.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css",
    "BRAND.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
