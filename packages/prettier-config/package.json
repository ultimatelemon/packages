{
  "name": "@ultimatelemon-eu/prettier-config",
  "version": "1.0.0",
  "description": "Shared Prettier configuration for UltimateLemon projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/packages.git",
