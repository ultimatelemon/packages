{
  "name": "@ultimatelemon-eu/mcp-http",
  "version": "2.3.0",
  "description": "Run an MCP server over stateless Streamable HTTP: /mcp, /healthz, a base path for proxies, the caller's own API key or a stateless OAuth sign-in, and errors that never leak a stack trace.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/packages.git",
    "directory": "packages/mcp-http"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.3.0"
  },
  "dependencies": {
    "@ultimatelemon-eu/crypto": "^1.0.0"
  }
}
